# ── EcoSoch Project Repository — backend (Google Sheets as database) ──────────
PORT=4000
# Deployed frontend origin (for CORS). e.g. https://projects.ecosoch.com
FRONTEND_URL=http://localhost:5173

# ── Google Sheets via Apps Script Web App ────────────────────────────────────
# The Apps Script /exec URL. The Apps Script is what is BOUND to the spreadsheet,
# so pointing at a different sheet is done in the Apps Script, not here.
SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_API_TOKEN=your-shared-token-matching-Code.gs
SHEETS_CACHE_TTL=60000
SHEETS_TIMEOUT=90000
SHEETS_MAX_STALE=900000

# ── Google sign-in ───────────────────────────────────────────────────────────
# OAuth 2.0 Web Client ID. Add the deployed frontend origin to
# "Authorised JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
JWT_SECRET=set-a-long-random-string
JWT_EXPIRES=7d
ALLOWED_EMAIL_DOMAIN=ecosoch.com
# domain = anyone @ecosoch.com signs in (auto-added to Users tab)
# sheet  = only addresses already in the Users tab may sign in
AUTH_MODE=domain
DEFAULT_ROLE=User
# Leave false until everyone has signed in once, then set true to lock the API.
REQUIRE_AUTH=false

# ── Optional: email notifications (leave blank to disable) ────────────────────
MAIL_SENDER_NAME=EcoSoch
TEAM_EMAILS=
